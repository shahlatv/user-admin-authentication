<!DOCTYPE html>
<html>

<head>

    <title>Edit User</title>

</head>

<body>

<h2>Edit User</h2>

<form action="/admin/edit-user/<%= user._id %>" method="POST">

<label>Name</label><br>

<input
type="text"
name="name"
value="<%= user.name %>"
required>

<br><br>

<label>Email</label><br>

<input
type="email"
name="email"
value="<%= user.email %>"
required>

<br><br>

<label>Role</label><br>

<select name="role">

<option value="user"
<%= user.role=="user"?"selected":"" %>>

User

</option>

<option value="admin"
<%= user.role=="admin"?"selected":"" %>>

Admin

</option>

</select>

<br><br>

<button type="submit">

Update User

</button>

</form>

</body>

</html>